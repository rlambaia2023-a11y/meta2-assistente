PORT=3103
# Protecao opcional do site no Railway (recomendada com chave):
APP_USER=
APP_PASSWORD=
# IA RECOMENDADA — Gemini gratis (Google AI Studio, sem cartao para comecar):
# 1. Entre em aistudio.google.com/apikey com sua conta Google
# 2. Clique em Create API key, copie e cole SO no Railway (nunca no chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Padrao gratis: Flash-Lite (mais barato). Se der 404, o servidor tenta gemini-3.8-flash.
# CACHE_MINUTOS=60 # mesma foto+pergunta volta do cache, sem gastar cota
# Nao ha variavel OpenAI: o provedor e so Gemini. Variaveis OPENAI_* antigas no Railway podem ser apagadas, sao ignoradas.
# Pesquisa em tempo real (opcional):
BRAVE_API_KEY=
# MODO_DEMO=1 # so para testar o pipeline sem gastar chave
